# ---------------------------------------------------------------------------
# Environment variables for the Docker Compose stack.
#
# For LOCAL Docker testing: copy this file to ".env" (docker compose reads it
# automatically) and adjust as needed, then run: docker compose up --build
#
# For COOLIFY: set these in the Coolify application's "Environment Variables"
# UI instead of committing a .env file.
#
# NOTE: the app's own .env (DB_HOST=localhost) is only for running under XAMPP
# on the host and is ignored inside the container (see .dockerignore).
# ---------------------------------------------------------------------------

# MySQL root password (used by both the db service and the app)
DB_PASS=evoting_secret

# Database name (auto-created by the app on first start)
DB_NAME=evoting_db

# Host port to expose the app on (container always listens on 3000)
APP_PORT=3000

# Timezone used for every timestamp shown/recorded by the system.
# DB_TIMEZONE must be the UTC offset matching TZ — MySQL is given an offset
# because the official image has no timezone-name tables loaded. Leave
# DB_TIMEZONE empty to let the app derive it from TZ automatically.
TZ=Asia/Bangkok
DB_TIMEZONE=+07:00

# Session cookie signing secret — MUST be a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# 1 = enable F2 card simulation (recommended in containers; no USB reader).
# Set to 0 only if you have a real PC/SC setup (not typical for Docker).
DEMO_MODE=1

# 1 = "Local Agent" mode: real cards are read by the card-agent program running
# on each kiosk PC (see the agent/ folder), NOT on this server. Use this when
# hosting on Cloud/Coolify with real USB readers at the voting stations.
# When AGENT_MODE=1 the requirements page treats the server-side PC/SC stack as
# optional (it lives on the kiosk, not the server). Set DEMO_MODE=0 for a real
# election. Leave AGENT_MODE=0 (and DEMO_MODE=1) for pure testing.
AGENT_MODE=0
